  "dialogue.merchant.key_pun":     { "context": "Каламбур на слове 'ключ' (ключ от двери / скрипичный ключ). Не переводить буквально — искать эквивалент или сознательно жертвовать игрой слов.", "max_length": { "en": 110, "ru": 120, "zh-Hans": 50 }, "placeholders": [] },
  "dialogue.merchant.door_key":    { "context": "Намёк на стол. Содержит идиому 'It's a piece of cake' — не переводить буквально, искать эквивалент.", "max_length": { "en": 115, "ru": 128, "zh-Hans": 55 }, "placeholders": [] },
  "dialogue.merchant.farewell":    { "context": "Прощание торговца. Содержит идиому 'Break a leg' — не переводить буквально, искать эквивалент. Обращение неформальное.", "max_length": { "en": 24, "ru": 28, "zh-Hans": 12 }, "placeholders": [] },
  "dialogue.merchant.repeat":      { "context": "Повторный разговор с торговцем. Коротко, по-деловому.",                                  "max_length": { "en": 46, "ru": 52, "zh-Hans": 22 }, "placeholders": [] },

